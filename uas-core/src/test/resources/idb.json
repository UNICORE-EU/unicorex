{

"Applications": [

  {
	"Name": "Date",
	"Version": "1.0",
	"Executable": "/bin/date",
	"Arguments": ["-R$RFC? $ARGUMENTS?", "--iso-8601=$ISOFORMAT?"],
	"Parameters" : {
	  "RFC": { "Type": "boolean",
	           "Description": "Output date and time in RFC 5322 format" },
	  "ISOFORMAT": { "Type": "choice",
	  		   "ValidValues": ["date", "hours", "minutes", "seconds", "ns"],
	           "Description": "Output date/time in ISO 8601 format, to the indicated precision"
	         }  
    }
  },
  
  {
	"Name": "Cat",
	"Version": "1.0",
	"Executable": "/bin/cat",
	"Arguments": ["$ARGUMENTS?"]
  }
],

   "Partitions": {
   	"batch" : {
   		"IsDefaultPartition": "true",
   		"Resources" : {
   		        "Runtime": "1-3600:60",
				"Nodes" : "1-1:1",
				"CPUsPerNode" : "1-1:1",
				"TotalCPUs" : "1-1",
				"MemoryPerNode" : "1G-1G",
				"TurboMode": {
					"Type": "CHOICE",
 					"AllowedValues" : ["eco", "normal", "turbo"],
 					"Default": "normal"
				},
				"NetworkBooster": {
					"Type": "BOOLEAN",
 					"Default": "true"
				}
	    	}
   	}

   }
 
}
